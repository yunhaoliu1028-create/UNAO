generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ESTIMATOR
  MANAGER
  ACCOUNTING
  OWNER_ADMIN
}

enum EstimateStatus {
  UPLOADED
  PARSING
  PARSED
  FAILED
}

enum InvoiceStatus {
  DRAFT
  APPROVED
  EXPORTED
  SUBMITTED
  SETTLED
}

enum StrategyTier {
  BASIC
  NORMAL
  AGGRESSIVE
}

enum SourceType {
  GENERATED
  MANUAL
}

model Tenant {
  id            String             @id @default(cuid())
  name          String
  timezone      String             @default("America/Los_Angeles")
  currency      String             @default("USD")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  users         User[]
  carriers      InsuranceCarrier[]
  strategyRules ConsumableRule[]
  strategies    StrategyProfile[]
  estimates     Estimate[]
  invoices      Invoice[]
  auditLogs     AuditLog[]
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  email        String    @unique
  passwordHash String
  firstName    String?
  lastName     String?
  role         UserRole
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auditLogs    AuditLog[]

  @@index([tenantId, role])
}

model InsuranceCarrier {
  id                String            @id @default(cuid())
  tenantId          String
  name              String
  code              String?
  defaultStrategyId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  strategies        StrategyProfile[]
  invoices          Invoice[]

  @@unique([tenantId, name])
  @@index([tenantId, createdAt])
}

model StrategyProfile {
  id                String                 @id @default(cuid())
  tenantId          String
  insuranceCarrierId String
  name              String
  tier              StrategyTier
  laborMultiplier   Decimal                @default(1.0) @db.Decimal(8, 4)
  materialMultiplier Decimal               @default(1.0) @db.Decimal(8, 4)
  minLineItems      Int                    @default(1)
  maxLineItems      Int                    @default(200)
  notesTemplate     String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  carrier           InsuranceCarrier       @relation(fields: [insuranceCarrierId], references: [id], onDelete: Cascade)
  overrides         StrategyRuleOverride[]
  invoices          Invoice[]

  @@unique([insuranceCarrierId, tier])
  @@index([tenantId, tier])
}

model ConsumableRule {
  id               String                 @id @default(cuid())
  tenantId         String
  code             String
  name             String
  operationType    String
  formula          Json
  defaultUnit      String
  defaultUnitPrice Decimal                @db.Decimal(12, 2)
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  overrides        StrategyRuleOverride[]
  invoiceLines     InvoiceLine[]

  @@unique([tenantId, code])
  @@index([tenantId, operationType, isActive])
}

model StrategyRuleOverride {
  id               String          @id @default(cuid())
  strategyProfileId String
  consumableRuleId String
  isEnabled        Boolean         @default(true)
  multiplier       Decimal         @default(1.0) @db.Decimal(8, 4)
  minQty           Decimal?        @db.Decimal(10, 3)
  maxQty           Decimal?        @db.Decimal(10, 3)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  strategy         StrategyProfile @relation(fields: [strategyProfileId], references: [id], onDelete: Cascade)
  rule             ConsumableRule  @relation(fields: [consumableRuleId], references: [id], onDelete: Cascade)

  @@unique([strategyProfileId, consumableRuleId])
}

model Estimate {
  id                   String            @id @default(cuid())
  tenantId             String
  sourceSystem         String?
  sourceEstimateNumber String?
  claimNumber          String?
  vin                  String?
  status               EstimateStatus    @default(UPLOADED)
  parseError           String?
  normalizedPayload    Json?
  createdByUserId      String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  tenant               Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  files                EstimateFile[]
  operations           RepairOperation[]
  aiRuns               AIExtractionRun[]
  invoices             Invoice[]

  @@index([tenantId, status, createdAt])
  @@index([tenantId, claimNumber])
  @@index([tenantId, vin])
}

model EstimateFile {
  id          String   @id @default(cuid())
  estimateId  String
  storageKey  String
  fileName    String
  mimeType    String
  fileSize    Int
  createdAt   DateTime @default(now())

  estimate    Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId, createdAt])
}

model RepairOperation {
  id                  String   @id @default(cuid())
  estimateId          String
  operationCode       String?
  operationType       String
  panelName           String?
  laborHours          Decimal? @db.Decimal(10, 2)
  paintHours          Decimal? @db.Decimal(10, 2)
  areaSqFt            Decimal? @db.Decimal(10, 3)
  isReplacement       Boolean  @default(false)
  rawData             Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  estimate            Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId, operationType])
}

model AIExtractionRun {
  id              String   @id @default(cuid())
  estimateId      String
  modelProvider   String
  modelName       String
  promptVersion   String
  schemaVersion   String
  status          String
  outputJson      Json?
  errorMessage    String?
  startedAt       DateTime @default(now())
  completedAt     DateTime?

  estimate        Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId, startedAt])
}

model Invoice {
  id                 String          @id @default(cuid())
  tenantId           String
  estimateId         String
  insuranceCarrierId String
  strategyProfileId  String
  invoiceNumber      String
  status             InvoiceStatus   @default(DRAFT)
  currency           String          @default("USD")
  subtotal           Decimal         @default(0) @db.Decimal(12, 2)
  taxAmount          Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal         @default(0) @db.Decimal(12, 2)
  claimNumber        String?
  vin                String?
  createdByUserId    String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  estimate           Estimate        @relation(fields: [estimateId], references: [id], onDelete: Restrict)
  carrier            InsuranceCarrier @relation(fields: [insuranceCarrierId], references: [id], onDelete: Restrict)
  strategy           StrategyProfile @relation(fields: [strategyProfileId], references: [id], onDelete: Restrict)
  lines              InvoiceLine[]
  versions           InvoiceVersion[]
  attachments        Attachment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status, createdAt])
}

model InvoiceVersion {
  id          String   @id @default(cuid())
  invoiceId   String
  versionNo   Int
  snapshot    Json
  createdBy   String?
  createdAt   DateTime @default(now())

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, versionNo])
}

model InvoiceLine {
  id               String      @id @default(cuid())
  invoiceId        String
  consumableRuleId String?
  lineNo           Int
  description      String
  qty              Decimal     @db.Decimal(10, 3)
  unit             String
  unitPrice        Decimal     @db.Decimal(12, 2)
  amount           Decimal     @db.Decimal(12, 2)
  sourceType       SourceType  @default(GENERATED)
  sourceOperationRef String?
  sourceMetadata   Json?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  invoice          Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  rule             ConsumableRule? @relation(fields: [consumableRuleId], references: [id], onDelete: SetNull)

  @@unique([invoiceId, lineNo])
}

model Attachment {
  id          String   @id @default(cuid())
  invoiceId   String
  type        String
  storageKey  String
  fileName    String
  mimeType    String
  createdAt   DateTime @default(now())

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, type])
}

model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String?
  objectType   String
  objectId     String
  action       String
  diffSummary  Json?
  createdAt    DateTime @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([objectType, objectId, createdAt])
}
